{
  "name": "quant-swarm",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.ts src/alpaca-paper-adapter.ts src/fixture-ingestor.ts src/sec-ingestor.ts --bundle --platform=node --outdir=dist --format=esm",
    "worker": "node dist/worker.js",
    "alpaca:read": "node dist/alpaca-paper-adapter.js",
    "game:build": "esbuild src/game/agent.ts --bundle --platform=node --outfile=dist/game/agent.js --format=esm && swiftc src/game/macos-desktop.swift -o dist/game/macos-desktop",
    "game:run": "node dist/game/agent.js",
    "ingest:fixture": "node dist/fixture-ingestor.js",
    "ingest:sec": "node dist/sec-ingestor.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p spacetimedb/tsconfig.json",
    "db:start": "spacetime start --listen-addr 127.0.0.1:3000 --data-dir .spacetimedb-data --non-interactive",
    "db:publish": "spacetime publish --module-path spacetimedb --server local quant-swarm",
    "db:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "workspaces": ["spacetimedb"],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "openai": "^7.27.0",
    "spacetimedb": "2.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2",
    "undici": "^6.19.2"
  }
}
